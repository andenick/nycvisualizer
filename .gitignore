# ---- Secrets — never commit ----
.env
*.env
!.env.example

# ---- Data lake / large regenerable artifacts (rebuild from public sources) ----
# The pipeline downloads + derives these; they are NOT part of the repo.
pipeline/data/
pipeline/realtime/archive/
pipeline/realtime/derived/
pipeline/realtime/logs/
pipeline/realtime/*.lock
pipeline/**/POLLER_STATUS.json
outputs/
_scratch/
*.duckdb
*.duckdb.wal
*.parquet
*.rdb

# Keep the deliberate, self-hosted committed assets (they override the rules above):
!site/frontend/public/basemap/nyc-basemap-z15b.pmtiles   # ~95 MiB NYC vector basemap, Planetiler maxzoom 15 (no CDN)
# The Sidewalk Explorer web layers under site/frontend/public/layers/*.geojson are
# intentionally committed (small, simplified) and are not matched by any rule above.

# ---- Node / frontend build ----
node_modules/
dist/
.vite/
*.tsbuildinfo

# ---- Python ----
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.mypy_cache/
.pytest_cache/

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db

# Build tools fetched on demand (go-pmtiles for site/tools/build_basemap.sh, etc.) —
# binaries are tools, not source artifacts.
site/tools/bin/

# ---- Internal content sources — never publish ----
# site/content_src/ holds the hand-curated inputs to the pre-rendered site content,
# including the internal research-archive document ids used to quote-verify each
# "From the archive" passage. Those ids resolve only inside our own workspace
# (CODE_DATA_FIRST_STANDARD s4.2), so the SOURCE stays here and only the stripped,
# reader-resolvable kb_callouts.json is generated into site/frontend/src/content/.
site/content_src/

# Local index into our research archive (year -> extracted-report folder) used by
# pipeline/analysis/cordon/build_hub_bound_series.py. The underlying documents are NYMTC's
# PUBLISHED Hub Bound Travel Reports; only our folder names are internal, and they resolve
# to nothing outside this workspace. An outside reproducer supplies their own.
pipeline/analysis/cordon/archive_sources.local.json
